# Copier ce fichier vers .env puis adapter les valeurs.
# Generer une cle : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=remplacer-par-une-longue-valeur-aleatoire
DATABASE_URL=sqlite:///./authguard.db

# Mettre true derriere HTTPS (production). Laisser false en local (HTTP).
COOKIE_SECURE=false
# lax ou strict
COOKIE_SAMESITE=lax
# Duree de vie d'une session, en secondes (8 heures par defaut)
SESSION_MAX_AGE_SECONDS=28800
